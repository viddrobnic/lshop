{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol",
  "default_agent": "build",
  "agent": {
    "build": {
      "model": "openai/gpt-5.6-sol"
    },
    "plan": {
      "model": "openai/gpt-5.6-sol"
    },
    "general": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.6-terra"
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "npx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
