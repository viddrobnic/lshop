{
  "name": "lshop-frontend",
  "version": "0.0.0",
  "description": "LShop shopping list web application",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "serve": "vite preview",
    "tsc": "tsc --noEmit",
    "prettier:check": "prettier --check package.json vite.config.ts tsconfig.json .oxlintrc.json postcss.config.js components.json src index.html",
    "prettier:write": "prettier --write package.json vite.config.ts tsconfig.json .oxlintrc.json postcss.config.js components.json src index.html",
    "lint": "oxlint src vite.config.ts",
    "test": "vitest run src --passWithNoTests",
    "test:watch": "vitest src",
    "check": "npm run tsc && npm run lint && npm run prettier:check && npm run test && npm run build"
  },
  "license": "MIT",
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.0",
    "msw": "3.0.5",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2007",
    "prettier": "3.10.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/react": "0.5.3",
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-query": "5.107.1",
    "@tanstack/react-query-devtools": "5.107.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "shadcn": "4.23.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2"
  }
}
